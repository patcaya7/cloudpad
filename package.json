  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:store": "npm run tauri build -- --no-bundle && npm run tauri bundle -- --config src-tauri/tauri.microsoftstore.conf.json",
    "prepare:updater": "node scripts/prepare-updater-build.mjs",
